<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_color"
    android:orientation="vertical"
    android:paddingStart="20dp"
    android:paddingTop="24dp"
    android:paddingEnd="20dp"
    android:paddingBottom="16dp"
    tools:context=".GameActivity">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="GAME ROOM"
        android:textColor="@color/text_muted"
        android:textSize="12sp"
        android:letterSpacing="0.18"
        android:textStyle="bold" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/game_status_text"
        android:gravity="center"
        android:textSize="18sp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="18dp"
        android:textStyle="bold"
        android:text="Game not started"
        android:textColor="@color/status_text_color"
        android:background="@drawable/bg_status"
        android:padding="15dp"
        android:maxLines="2" />

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/bg_surface"
        android:columnCount="3">

        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="0"
            android:id="@+id/btn_0"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="1"
            android:id="@+id/btn_1"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="2"
            android:id="@+id/btn_2"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="3"
            android:id="@+id/btn_3"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="4"
            android:id="@+id/btn_4"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="5"
            android:id="@+id/btn_5"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="6"
            android:id="@+id/btn_6"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="7"
            android:id="@+id/btn_7"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
        <Button android:layout_width="0dp"
            android:layout_height="88dp"
            android:layout_columnWeight="1"
            android:layout_margin="5dp"
            android:textSize="42sp"
            android:tag="8"
            android:id="@+id/btn_8"
            android:background="@drawable/bg_cell"
            android:backgroundTint="@null"
            android:textColor="@color/text_color"
            android:textStyle="bold"/>
    </GridLayout>

    <Button
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="14dp"
        android:id="@+id/start_game_btn"
        android:text="START MATCH"
        android:textColor="@android:color/white"
        android:textSize="13sp"
        android:textStyle="bold"
        android:background="@drawable/bg_button_primary"
        android:backgroundTint="@null"/>

    <!-- New Chat part that i have added on 16th september for firebase realtime database -->

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/chatRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/bg_surface"
        android:scrollbars="vertical"
        android:layout_marginTop="14dp"
        android:padding="10dp"
        android:clipToPadding="false" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
         android:layout_marginTop="10dp"
         android:gravity="center_vertical">

        <EditText
            android:id="@+id/messageInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:hint="Type a message"
             android:layout_marginEnd="8dp"
            android:inputType="text"
             android:padding="12dp"
             android:background="@drawable/bg_input"
             android:textColor="@color/text_color"
             android:textColorHint="@color/text_subtle"
             android:backgroundTint="@null"/>

        <Button
            android:id="@+id/sendButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
             android:text="SEND"
             android:textColor="@android:color/white"
             android:textSize="12sp"
             android:textStyle="bold"
             android:background="@drawable/bg_button_primary"
             android:backgroundTint="@null"/>
    </LinearLayout>

</LinearLayout>